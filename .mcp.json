{
  "mcpServers": {
    "gmail": {
      "command": "python",
      "args": [
        "-m",
        "avaya_case_review_runtime.gmail_mcp_server"
      ],
      "env": {
        "GMAIL_BACKEND": "edge_broker",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "CaseToMD": {
      "command": "python",
      "args": [
        "-m",
        "avaya_case_review_runtime.casetomd_mcp_bridge"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
